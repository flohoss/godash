package views

import (
	"github.com/flohoss/godash/config"
	"github.com/flohoss/godash/services"
	"github.com/flohoss/godash/views/bookmarks"
	"github.com/flohoss/godash/views/layout"
	"github.com/flohoss/godash/views/links"
	"github.com/flohoss/godash/views/system"
	"github.com/flohoss/godash/views/weather"
)

templ Home(title string, b []config.Category, l []config.Category, buffer services.Buffer, static services.Static, d []services.Day, h []services.Hour) {
	@layout.Page(title, content(b, l, buffer, static, d, h))
}

templ content(b []config.Category, l []config.Category, buffer services.Buffer, static services.Static, d []services.Day, h []services.Hour) {
	<div class="mt-4 mb-8 md:my-8 lg:my-10">
		@weather.Weather(d, h)
	</div>
	<div class="py-3">
		@system.System(buffer, static)
	</div>
	<div class="my-4 md:my-8 lg:my-10">
		<div class="grid gap-8 lg:gap-12">
			@bookmarks.Bookmarks(b)
			@links.Links(l)
		</div>
	</div>
}
